<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.shardflow</groupId>
        <artifactId>shardflow-system</artifactId>
        <version>0.2.0</version>
    </parent>

    <artifactId>shardflow-config</artifactId>
    <name>ShardFlow Config</name>
    <description>Custom model and agent configuration management</description>

    <dependencies>
        <dependency>
            <groupId>com.shardflow</groupId>
            <artifactId>shardflow-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shardflow</groupId>
            <artifactId>shardflow-user-context</artifactId>
        </dependency>
        <!-- MinIO：Skill Artifact 对象存储（DR-6）。
             MinioClient Bean 由 shardflow-kb 的 MinioConfig 在运行时提供，
             shardflow-app 同时引入 kb 与 config，复用同一 Bean 避免冲突。 -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
        </dependency>
        <!-- Commons Compress：Skill 压缩包导入（.tar.gz / .tgz）支持（P3.1）。
             ZIP 使用 JDK 内置 java.util.zip，TAR.GZ 需 commons-compress。 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
            <version>1.26.1</version>
        </dependency>
    </dependencies>
</project>
