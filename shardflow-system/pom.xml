<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.shardflow</groupId>
    <artifactId>shardflow-system</artifactId>
    <version>0.2.0</version>
    <packaging>pom</packaging>
    <name>ShardFlow System</name>
    <description>ShardFlow 单体 Java 服务：认证授权、数据持久化、用户画像、MCP 注册中心、策略管理</description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <modules>
        <module>shardflow-common</module>
        <module>shardflow-user-context</module>
        <module>shardflow-callback</module>
        <module>shardflow-shard</module>
        <module>shardflow-strategy</module>
        <module>shardflow-auth</module>
        <module>shardflow-profile</module>
        <module>shardflow-mcp</module>
        <module>shardflow-task</module>
        <module>shardflow-app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <mybatis-plus.version>3.5.16</mybatis-plus.version>
        <sa-token.version>1.45.0</sa-token.version>
        <pgvector.version>0.1.6</pgvector.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.shardflow</groupId>
                <artifactId>shardflow-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.shardflow</groupId>
                <artifactId>shardflow-user-context</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.shardflow</groupId>
                <artifactId>shardflow-callback</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.shardflow</groupId>
                <artifactId>shardflow-shard</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.shardflow</groupId>
                <artifactId>shardflow-strategy</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.shardflow</groupId>
                <artifactId>shardflow-auth</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.shardflow</groupId>
                <artifactId>shardflow-task</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.shardflow</groupId>
                <artifactId>shardflow-profile</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.shardflow</groupId>
                <artifactId>shardflow-mcp</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- MyBatis-Plus BOM -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-bom</artifactId>
                <version>${mybatis-plus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- ========== 全局依赖（所有子模块继承） ========== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
