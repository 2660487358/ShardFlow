# =============================================================================
# ShardFlow Unified Environment Variables Template
# =============================================================================
# Naming convention: {SF}_{LAYER}_{COMPONENT}_{ATTRIBUTE}
#   SF_AGENT_*    → Python Inference Layer (shardflow-agent)
#   SF_SYSTEM_*   → Java Peripheral Service (shardflow-system)
#   SF_INFRA_*    → Shared Infrastructure (PostgreSQL, Redis, MinIO, Milvus, MySQL)
#   VITE_SF_*     → Frontend (shardflow-frontend, VITE_ prefix required by Vite)
#
# Priority: Runtime env vars > docker-compose env > .env file > code defaults
# =============================================================================

# ─── P0: Secrets (MUST set before deployment) ────────────────────────────────

# LLM Service
SF_AGENT_LLM_API_KEY=
SF_AGENT_LLM_BASE_URL=

# Java Service Authentication
SF_AGENT_JAVA_API_KEY=

# Sa-Token JWT Secret (production MUST override)
SA_TOKEN_JWT_SECRET_KEY=ShardFlow2026DefaultJwtSecretKeyDoNotUseInProd

# External Retrieval Sources
SF_AGENT_STACKEXCHANGE_API_KEY=
SF_AGENT_GITHUB_TOKEN=

# ─── P1: Infrastructure Connections ─────────────────────────────────────────

# PostgreSQL
SF_INFRA_POSTGRES_HOST=localhost
SF_INFRA_POSTGRES_PORT=5432
SF_INFRA_POSTGRES_DB=shardflow
SF_INFRA_POSTGRES_USER=shardflow
SF_INFRA_POSTGRES_PASSWORD=shardflow

# Redis
SF_INFRA_REDIS_URL=redis://localhost:6379/0
SF_INFRA_REDIS_PORT=6379
SF_INFRA_REDIS_PASSWORD=

# MinIO Object Storage
SF_INFRA_MINIO_ENDPOINT=localhost:9000
SF_INFRA_MINIO_ACCESS_KEY=minioadmin
SF_INFRA_MINIO_SECRET_KEY=minioadmin
SF_INFRA_MINIO_BUCKET=shardflow
SF_INFRA_MINIO_API_PORT=9000
SF_INFRA_MINIO_CONSOLE_PORT=9001

# Milvus Vector DB
SF_INFRA_MILVUS_HOST=localhost
SF_INFRA_MILVUS_PORT=19530
SF_INFRA_MILVUS_GRPC_PORT=9091

# MySQL (Milvus metadata)
SF_INFRA_MYSQL_PORT=3306
SF_INFRA_MYSQL_ROOT_PASSWORD=shardflow
SF_INFRA_MYSQL_DATABASE=shardflow
SF_INFRA_MYSQL_USER=shardflow
SF_INFRA_MYSQL_PASSWORD=shardflow

# ─── P2: Application Behavior (adjustable at runtime) ───────────────────────

# Python Inference Layer
SF_AGENT_APP_ENV=dev
SF_AGENT_API_HOST=0.0.0.0
SF_AGENT_API_PORT=8000
SF_AGENT_JAVA_BASE_URL=http://localhost:8200
SF_AGENT_REDIS_URL=redis://localhost:6379/0
SF_AGENT_LOG_LEVEL=INFO
SF_AGENT_SHARD_CACHE_TTL=1800
SF_AGENT_RETRIEVAL_SOURCES_ENABLED=official_doc,stackoverflow,github

# Java Peripheral Service
SF_SYSTEM_SERVER_PORT=8200
SF_SYSTEM_LOG_LEVEL=INFO

# Frontend
VITE_SF_API_BASE_URL=/agent/v1
VITE_SF_AUTH_BASE_URL=/auth
VITE_SF_SYSTEM_BASE_URL=/api/v1
VITE_SF_AGENT_PROXY=http://localhost:8000
VITE_SF_SYSTEM_PROXY=http://localhost:8200
