APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=8000
REDIS_URL=redis://localhost:6379/0
JAVA_BASE_URL=http://java-service:8080
JAVA_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=
LOG_LEVEL=INFO
SHARD_CACHE_TTL=1800

# 检索源 API 认证
STACKEXCHANGE_API_KEY=
GITHUB_TOKEN=

# 检索源开关（逗号分隔：official_doc,stackoverflow,github）
RETRIEVAL_SOURCES_ENABLED=official_doc,stackoverflow,github

# PostgreSQL 连接（Java 外围服务使用）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=shardflow
POSTGRES_USER=shardflow
POSTGRES_PASSWORD=shardflow

# MinIO 对象存储
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=shardflow
