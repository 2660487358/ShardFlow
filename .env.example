# ShardFlow Environment Variables
# Copy to .env and adjust as needed

# LLM Configuration
LLM_API_KEY=sk-your-api-key
LLM_BASE_URL=https://api.openai.com

# Java Peripheral Service
JAVA_API_KEY=your-java-api-key

# External API keys
STACKEXCHANGE_API_KEY=
GITHUB_TOKEN=

# Database
POSTGRES_USER=shardflow
POSTGRES_PASSWORD=shardflow
