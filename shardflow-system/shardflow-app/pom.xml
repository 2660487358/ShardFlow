<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.shardflow</groupId>
        <artifactId>shardflow-system</artifactId>
        <version>0.2.0</version>
    </parent>
    <artifactId>shardflow-app</artifactId>
    <packaging>jar</packaging>
    <name>ShardFlow App</name>
    <description>单体应用启动入口</description>
    <dependencies>
        <dependency><groupId>com.shardflow</groupId><artifactId>shardflow-common</artifactId></dependency>
        <dependency><groupId>com.shardflow</groupId><artifactId>shardflow-user-context</artifactId></dependency>
        <dependency><groupId>com.shardflow</groupId><artifactId>shardflow-callback</artifactId></dependency>
        <dependency><groupId>com.shardflow</groupId><artifactId>shardflow-shard</artifactId></dependency>
        <dependency><groupId>com.shardflow</groupId><artifactId>shardflow-strategy</artifactId></dependency>
        <dependency><groupId>com.shardflow</groupId><artifactId>shardflow-auth</artifactId></dependency>
        <dependency><groupId>com.shardflow</groupId><artifactId>shardflow-task</artifactId></dependency>
        <dependency><groupId>com.shardflow</groupId><artifactId>shardflow-profile</artifactId></dependency>
        <dependency><groupId>com.shardflow</groupId><artifactId>shardflow-mcp</artifactId></dependency>
        <!-- MyBatis-Plus -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>
        <!-- Sa-Token -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot4-starter</artifactId>
            <version>${sa-token.version}</version>
        </dependency>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-jwt</artifactId>
            <version>${sa-token.version}</version>
        </dependency>
        <!-- Sa-Token 整合 Redis（使用 Jackson 序列化） -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-redis-jackson</artifactId>
            <version>${sa-token.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
